generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  
  // OTP Fields
  otpCode      String?
  otpExpiresAt DateTime?
  isVerified   Boolean   @default(false)
  
  tasks     Task[]   
}

enum Status {
  DRAFT
  IN_PROGRESS
  TESTING
  DONE
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      Status   @default(DRAFT)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}